# App Environment
APP_ENV=dev

# MySQL DB (local)
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=goldgym
USERNAME_DB=root
PASSWORD_DB=root
DATABASE_CONFIG=charset=utf8mb4&parseTime=True&loc=Local

# DB Connection Pool
SET_CONN_MAX_LIFETIME=60
SET_MAX_IDLE_CONNS=20
SET_MAX_OPEN_CONNS=200
DATABASE_DEBUG=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# JWT
JWT_SECRET=changeme_local_secret_key_32chars

# System Token (for service-to-service calls)
SYSTEM_TOKEN=local-system-token

# Auth service URL
AUTH_API_URL=http://users:8080

# App Origins
APP_BUYER_NAME=web
APP_MOBILE_NAME=mobile
APP_ADMIN_NAME=admin
APP_SYSTEM_NAME=system
APP_WORKER_NAME=worker

# Sentry (optional)
SENTRY_DSN=

# Ports
USERS_PORT=8081
MEMBERS_PORT=8082
